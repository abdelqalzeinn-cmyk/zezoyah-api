# ─────────────────────────────────────────────────────
# Zezoyah Backend API — Environment Variables
# Copy this file to `.env` and fill in real values.
# ─────────────────────────────────────────────────────

# Server port (Render sets PORT automatically; use 4000 locally)
PORT=4000
NODE_ENV=development

# JWT secret for signing auth tokens (CHANGE THIS in production!)
JWT_SECRET=change-this-to-a-long-random-string

# hCaptcha — get these from https://dashboard.hcaptcha.com
# HCAPTCHA_SECRET is server-side only (never exposed to frontend).
# HCAPTCHA_SITE_KEY is safe to expose to the frontend (used in the hCaptcha widget).
HCAPTCHA_SECRET=ES_21cf049f053f4818bffa3fc3ba24a40f
HCAPTCHA_SITE_KEY=eb2828ee-e81c-4246-a35e-d7bab6622cc4

# CORS — comma-separated list of allowed frontend origins
# In production: your frontend domain (e.g. https://zezoyah.onrender.com)
# In dev: http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000

# ── Image storage ──
# Driver: "local" (disk) or "s3" (S3-compatible, including Cloudflare R2)
IMAGE_STORAGE_DRIVER=local

# Used when IMAGE_STORAGE_DRIVER=local
# Path to the folder containing img_0001.jpg, img_0002.png, etc.
IMAGE_LOCAL_PATH=./uploads

# Used when IMAGE_STORAGE_DRIVER=s3
# S3_ENDPOINT allows Cloudflare R2 (set to your R2 endpoint URL)
# S3_BUCKET=zezoyah-images
# S3_REGION=auto
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key
# S3_ENDPOINT=https://xxxxx.r2.cloudflarestorage.com

# ── Database ──
# SQLite file path. On Render, use a persistent disk mount path.
# If no persistent disk, the DB resets on each deploy — see README for options.
DATABASE_PATH=./data/zezoyah.db
